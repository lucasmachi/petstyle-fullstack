# Desenvolvimento local. Execute comandos a partir da pasta backend.
APP_ENV=development
DATABASE_URL=sqlite:///./petstyle.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
DEMO_MODE=true
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Pet Style <agenda@petstyle.example>
TIMEZONE=America/Sao_Paulo
